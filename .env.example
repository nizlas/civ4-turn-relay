# Copy this file to `.env` and fill in local values.
# `.env` is for your machine only and must never be committed.
#
# Prefer SSH private keys over passwords where practical.
# Passwords stored in `.env` are plaintext local secrets.
# The application must never log credentials.

# --- Local player / Civilization IV ---
CIV4_RELAY_PLAYER_NAME=YourPlayerName
CIV4_RELAY_CIV4_EXECUTABLE=C:\Path\To\Civ4BeyondSword.exe
CIV4_RELAY_MOD_NAME=AdvCiv
CIV4_RELAY_PBEM_SAVE_DIR=C:\Path\To\Beyond the Sword\Saves\pbem

# Polling interval in seconds while waiting for remote or local activity
CIV4_RELAY_POLL_INTERVAL_SECONDS=10

# Optional: launch Civilization IV into the downloaded save when a turn arrives
CIV4_RELAY_AUTO_LAUNCH=false

# --- SFTP (shared file store only; not a game server) ---
CIV4_RELAY_SFTP_HOST=sftp.example.com
CIV4_RELAY_SFTP_PORT=22
CIV4_RELAY_SFTP_USERNAME=your-sftp-username
CIV4_RELAY_SFTP_REMOTE_ROOT=/path/to/civ4-relay

# Optional authentication (prefer key-based auth)
CIV4_RELAY_SFTP_PRIVATE_KEY_PATH=
CIV4_RELAY_SFTP_PASSWORD=
