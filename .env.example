# Copy this file to `.env` and fill in local values.
# `.env` is for your machine only and must never be committed.
#
# Prefer SSH private keys over passwords where practical.
# Passwords stored in `.env` are plaintext local secrets.
# The application must never log credentials.
#
# This file holds GLOBAL installation/server settings only.
# Per-match values (local player identity, mod name, PBEM save
# directory, automatic launch, match display names, human order)
# belong in local per-match configuration and are intentionally
# absent from `.env`.
#
# CIV4_RELAY_SFTP_REMOTE_ROOT is the games collection root used by the
# storage adapter (paths look like `{game_id}/manifest.json`).
# Never put real server addresses, usernames, passwords, keys, or
# fingerprints in the repository.

# --- Logging ---
CIV4_RELAY_LOG_LEVEL=INFO

# Polling interval in seconds while waiting for remote or local activity
CIV4_RELAY_POLL_INTERVAL_SECONDS=10

# Optional default/global Civ IV executable used when seeding launch profiles
CIV4_RELAY_CIV4_EXECUTABLE=C:\Path\To\Civ4BeyondSword.exe

# --- SFTP (shared file store only; not a game server) ---
CIV4_RELAY_SFTP_HOST=sftp.example.com
CIV4_RELAY_SFTP_PORT=22
CIV4_RELAY_SFTP_USERNAME=your-sftp-username
CIV4_RELAY_SFTP_REMOTE_ROOT=/path/to/civ4-relay/games
CIV4_RELAY_SFTP_CONNECT_TIMEOUT_SECONDS=30

# Authentication: provide a password and/or a private key path.
# A passphrase may be set only when a private key path is set.
CIV4_RELAY_SFTP_PRIVATE_KEY_PATH=
CIV4_RELAY_SFTP_PRIVATE_KEY_PASSPHRASE=
CIV4_RELAY_SFTP_PASSWORD=

# Host-key verification (required): known_hosts and/or SHA-256 fingerprint.
# There is no "ignore host-key errors" mode.
# Obtain a fingerprint with:
#   ssh-keyscan -p 22 sftp.example.com | ssh-keygen -lf - -E sha256
# Configure either a known_hosts file path or CIV4_RELAY_SFTP_HOST_KEY_SHA256
# (form SHA256:base64...). Do not copy private keys into the repository.
CIV4_RELAY_SFTP_KNOWN_HOSTS_PATH=
CIV4_RELAY_SFTP_HOST_KEY_SHA256=
